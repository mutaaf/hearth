{
  "name": "hearth",
  "version": "0.8.0",
  "description": "One remote for every TV in the house. Finds your LG, Samsung, Roku and Google TV devices on the Wi-Fi and gives every phone a fast, ad-free remote.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "hearth": "bin/hearth.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "up": "node scripts/up.mjs",
    "down": "node scripts/down.mjs",
    "start": "node bin/hearth.js",
    "scan": "node bin/hearth.js scan",
    "test": "node --test \"test/*.test.js\"",
    "build:site": "node scripts/build-site.mjs",
    "deploy:site": "node scripts/build-site.mjs && npx --yes wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "aurora-field": "^3.3.0",
    "lgtv2": "^2.1.0",
    "multicast-dns": "^7.2.5",
    "node-forge": "^1.4.0",
    "openai": "^7.41.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.0"
  },
  "homepage": "https://mutaafaziz.com/hearth/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mutaaf/hearth.git"
  }
}
